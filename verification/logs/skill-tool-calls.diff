+import type { EngineInterface, Register, StateWrite } from 'claude-code'
 
 import type { ToolCall } from '../types'
+import { placementIn, readPlacement } from './pane-grid'
 
+const PLUGIN = 'tool-calls' // the name in .claude-plugin/plugin.json
 const PANE = 'tool-calls'
+const TITLE = 'Tool calls'
 // Change the tag when a call's fields change: it declines what an earlier
 // version stored, which outlives a reload.
 const calls = atom({ plugin: 'tool-calls', key: 'calls' } as const, [], {
   shape: 'calls-1',
 })
 
+type Resolvable = Parameters<EngineInterface['ui']['resolve']>[0]
+
+// rows: the number of lines the list may use. The drawing does not depend on the width.
+const drawCalls = async ($: EngineInterface, e: Resolvable, rows: number) => {
+  const { Box, Text } = $.ui.resolve(e)
+  const list = await read($, calls)
+  const room = Math.max(1, rows)
+
+  return (
+    <Box flexDirection="column">
+      {list.length === 0 && <Text dimColor>No tool calls yet.</Text>}
+      {list.slice(-room).map(call => (
+        <Text dimColor={call.isDone}>
+          {call.isDone ? 'done' : 'runs'} {call.tool}
+        </Text>
+      ))}
+    </Box>
+  )
+}
+
+// Does not open the pane while the list is drawn in a pane-grid cell.
+const openPane = async ($: EngineInterface) => {
+  if (await readPlacement($, PLUGIN)) return
+  await $.ui.open({ id: PANE, title: TITLE })
+}
+
+// Opens the pane again only when the cell was removed, so a pane the person closed stays closed.
+const placeOwnPane = async ($: EngineInterface, layout: unknown, previous: unknown) => {
+  const isPlaced = placementIn(layout, PLUGIN) != undefined
+  const isOpen = (await $.ui.panes()).some(pane => pane.id == PANE)
+  if (isPlaced && isOpen) return $.ui.close({ id: PANE })
+  if (isPlaced || isOpen || placementIn(previous, PLUGIN) == undefined) return
+  await $.ui.open({ id: PANE, title: TITLE })
+}
